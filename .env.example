# SEC asks automated clients to identify a name and contact email.
SEC_USER_AGENT=Your Name your-email@example.com

# EODHD personal API token used for historical EOD prices and corporate actions.
EODHD_API_TOKEN=
# Stop before the paid-plan ceiling. Failed HTTP attempts are counted too.
EODHD_API_DAILY_LIMIT=100000
EODHD_API_CALL_RESERVE=5000
# Seed this with the usage already shown in the EODHD dashboard.
EODHD_API_CALLS_USED=0
# Optional manual accounting period; omit to use the local calendar date.
EODHD_API_BUDGET_PERIOD=

# Optional OpenDART identity cross-check. Without it, the KR benchmark records
# an explicit skipped_missing_credentials status and keeps KRX ISIN identity.
DART_API_KEY=

# Required canonical Korean-market inputs. KRX Open API provides authenticated
# daily stock prices (AUTH_KEY header). Historical KOSPI200/KOSDAQ150
# constituents use the authenticated KRX Data Marketplace website.
KRX_OPENAPI_AUTH_KEY=
KRX_OPENAPI_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
# auto: OpenAPI first with authenticated-web failover. web: measured bulk path.
KRX_DAILY_PRICE_TRANSPORT=auto
# KRX Data Marketplace website login for historical index constituent snapshots.
# These are separate from KRX_OPENAPI_AUTH_KEY.
KRX_ID=
KRX_PW=
# Authenticated website cookies are credential-bound and kept local with 0600.
KRX_SESSION_CACHE_PATH=data/cache/private/krx_web_session.json
# Optional fallback: licensed complete historical snapshots instead of web login.
KRX_PIT_CONSTITUENTS_PATH=data/imports/krx/index_constituents.parquet
# Optional at benchmark time, but required by a full bootstrap whenever a
# terminal constituent needs merger/delisting economics. Rows must cite an
# official KRX, KIND, or OpenDART HTTP(S) page and use stable ISIN identity.
KR_OFFICIAL_ACTIONS_PATH=unified_quant/configs/market_data/kr_official_actions.csv
# Human-reviewed lifecycle exceptions are allowed only through this audited
# table; the pipeline validates reviewer, reason, source, and recheck policy.
KR_LIFECYCLE_RESOLUTIONS_PATH=unified_quant/configs/market_data/kr_lifecycle_resolutions.csv

# Korea Investment & Securities has distinct prod and paper applications.
# Market-data comparison defaults to prod and caches the 24-hour token locally
# because KIS rate-limits token reissuance. The account fields are reserved for
# the KIS execution adapter; the current order execution path remains Toss.
KIS_MARKET_DATA_MODE=prod
KIS_PROD_APP_KEY=
KIS_PROD_APP_SECRET=
KIS_PROD_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_PROD_ACCOUNT_NO=
KIS_PROD_ACCOUNT_PRODUCT_CODE=01
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=01
KIS_TOKEN_CACHE_PATH=data/cache/private/kis_prod_access_token.json
# Legacy prod aliases retained for existing installations.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional Cloudflare R2 credentials. Runtime YAML stores only these env names.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required by the fail-closed R2 privacy check before any write. The token
# needs Workers R2 Storage Read for the configured account and bucket.
# Optional consistency assertion. When omitted, the account ID is derived
# from the official R2_ENDPOINT_URL host.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional offline fallback: both values are required. The JSON attestation
# must be bucket-bound and its exact bytes pinned by this SHA-256. With
# privacy_recheck_policy=on_change it remains valid until the operator reports
# a bucket visibility change.
R2_PRIVACY_ATTESTATION_PATH=
R2_PRIVACY_ATTESTATION_SHA256=

# Optional human-readable publisher recorded in immutable manifests.
STQ_PUBLISHED_BY=

# Optional Telegram notifications for live and enabled paper runtimes.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Live Toss execution (not used by backtest/research data ingestion).
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=1
